<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.fiware.dataspace</groupId>
    <artifactId>connector</artifactId>
    <version>0.0.1</version>
    <packaging>pom</packaging>
    <modules>
        <module>it</module>
    </modules>

    <properties>
        <jdk.version>17</jdk.version>
        <release.version>17</release.version>

        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <version.io.kokuwa.maven.k3s-plugin>2.3.1</version.io.kokuwa.maven.k3s-plugin>
        <version.io.kokuwa.helm-maven-plugin>6.17.0</version.io.kokuwa.helm-maven-plugin>
        <version.org.apache.maven.plugins.maven-install>3.1.1</version.org.apache.maven.plugins.maven-install>
        <version.org.apache.maven.plugins.maven-source>2.4</version.org.apache.maven.plugins.maven-source>
        <version.org.apache.maven.plugins.maven-jar>3.3.0</version.org.apache.maven.plugins.maven-jar>
        <version.org.apache.maven.plugins.maven-dependency>3.1.1</version.org.apache.maven.plugins.maven-dependency>
        <version.org.apache.maven.plugins.maven-surefire>3.0.0</version.org.apache.maven.plugins.maven-surefire>
        <version.org.apache.maven.plugins.maven-failsafe>3.0.0</version.org.apache.maven.plugins.maven-failsafe>

        <!-- allows to set the port of the k3s api.-->
        <k3s.kubeApi.port>6443</k3s.kubeApi.port>

        <main.basedir>${project.basedir}</main.basedir>

        <!-- helm version the data space is deployed with -->
        <helm.version>3.17.3</helm.version>

        <!-- What k3s/deploy.sh deploys, overridden by the profiles. Values files are
             comma-separated and relative to the repository root; a release without
             values files is not installed. -->
        <deploy.skip>true</deploy.skip>
        <deploy.trustAnchor.values>k3s/trust-anchor.yaml</deploy.trustAnchor.values>
        <deploy.consentAuthority.values></deploy.consentAuthority.values>
        <deploy.provider.values>k3s/provider.yaml</deploy.provider.values>
        <deploy.consumer.values>k3s/consumer.yaml</deploy.consumer.values>
        <deploy.prometheus.values></deploy.prometheus.values>
        <deploy.gaiaxInfra>false</deploy.gaiaxInfra>
    </properties>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <testResources>
            <testResource>
                <directory>src/test/resources</directory>
                <filtering>true</filtering>
            </testResource>
        </testResources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-install-plugin</artifactId>
                <version>${version.org.apache.maven.plugins.maven-install}</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>${version.org.apache.maven.plugins.maven-source}</version>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>${version.org.apache.maven.plugins.maven-dependency}</version>

            </plugin>
            <!-- disable jar/surefire -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>${version.org.apache.maven.plugins.maven-jar}</version>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${version.org.apache.maven.plugins.maven-surefire}</version>
                <executions>
                    <execution>
                        <id>default-test</id>
                        <phase/>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>${version.org.apache.maven.plugins.maven-failsafe}</version>
                <configuration>
                    <failIfNoTests>false</failIfNoTests>
                    <includes>
                        <include>**/RunCucumberTest.java</include>
                    </includes>
                </configuration>
                <executions>
                    <execution>
                        <id>test</id>
                        <phase>integration-test</phase>
                        <goals>
                            <goal>integration-test</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>verify</id>
                        <phase>integration-test</phase>
                        <goals>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-deploy-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>

            <!-- Deploys the data space into a k3s cluster. Off unless a profile turns it on
                 (`deploy.skip`): `local`/`consent` here, `test` in the integration-test module.
                 The three plugins run in this order within the bound phase:
                 1. helm-maven-plugin downloads the pinned helm binary (`helm.version`),
                 2. k3s-maven-plugin starts the cluster and writes its kubeconfig,
                 3. k3s/deploy.sh installs every chart as a helm release
                    (helm upgrade with install), with the values files the profiles select. -->
            <plugin>
                <groupId>io.kokuwa.maven</groupId>
                <artifactId>helm-maven-plugin</artifactId>
                <version>${version.io.kokuwa.helm-maven-plugin}</version>
                <configuration>
                    <skip>${deploy.skip}</skip>
                    <addDefaultRepo>false</addDefaultRepo>
                    <!-- required by the plugin; only the helm binary is used, k3s/deploy.sh installs the charts -->
                    <chartDirectory>${main.basedir}/charts/data-space-connector</chartDirectory>
                </configuration>
                <executions>
                    <execution>
                        <id>install-helm</id>
                        <phase>package</phase>
                        <goals>
                            <goal>init</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>io.kokuwa.maven</groupId>
                <artifactId>k3s-maven-plugin</artifactId>
                <version>${version.io.kokuwa.maven.k3s-plugin}</version>
                <configuration>
                    <skip>${deploy.skip}</skip>
                    <disableLocalStorage>false</disableLocalStorage>
                    <portKubeApi>${k3s.kubeApi.port}</portKubeApi>
                    <portBindings>
                        <!-- Traefik http & https-->
                        <portBinding>8080:8080</portBinding>
                        <portBinding>8443:8443</portBinding>
                        <!-- Squid proxy -->
                        <portBinding>8888:8888</portBinding>
                    </portBindings>
                </configuration>
                <executions>
                    <execution>
                        <id>start-cluster</id>
                        <phase>deploy</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <failIfExists>false</failIfExists>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>1.8</version>
                <executions>
                    <execution>
                        <id>deploy-dataspace</id>
                        <phase>deploy</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <skip>${deploy.skip}</skip>
                            <target>
                                <exec executable="/bin/bash" failonerror="true">
                                    <arg value="${main.basedir}/k3s/deploy.sh" />
                                    <env key="KUBECONFIG" value="${project.build.directory}/k3s.yaml" />
                                    <env key="HELM" value="${project.build.directory}/helm/helm" />
                                    <env key="TRUST_ANCHOR_VALUES" value="${deploy.trustAnchor.values}" />
                                    <env key="CONSENT_AUTHORITY_VALUES" value="${deploy.consentAuthority.values}" />
                                    <env key="PROVIDER_VALUES" value="${deploy.provider.values}" />
                                    <env key="CONSUMER_VALUES" value="${deploy.consumer.values}" />
                                    <env key="PROMETHEUS_VALUES" value="${deploy.prometheus.values}" />
                                    <env key="GAIA_X_INFRA" value="${deploy.gaiaxInfra}" />
                                </exec>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <!-- The profiles select what is deployed by setting the `deploy.*` properties. A
             profile that only changes the values files can be combined with `local` (or
             with `test` in the integration-test module), e.g. `mvn clean deploy -Plocal,dsp`. -->
        <profile>
            <id>local</id>
            <properties>
                <deploy.skip>false</deploy.skip>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-compiler-plugin</artifactId>
                        <configuration>
                            <skip>true</skip>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <version>${version.org.apache.maven.plugins.maven-failsafe}</version>
                        <configuration>
                            <skip>true</skip>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <!-- Local deploy of the consent-management scenario: the standard local
                 provider/consumer stack plus the consent overlay layered onto the
                 provider (`-f k3s/provider.yaml -f k3s/consent-provider.yaml`) and the
                 trust anchor, and the consent authority as a second release of the
                 connector chart in the trust-anchor namespace. Every consent component
                 is pulled as a published image or chart - nothing is built here. Run
                 standalone: `mvn clean deploy -Pconsent`. -->
            <id>consent</id>
            <properties>
                <deploy.skip>false</deploy.skip>
                <deploy.trustAnchor.values>k3s/trust-anchor.yaml,k3s/consent-trust-anchor-components.yaml</deploy.trustAnchor.values>
                <deploy.consentAuthority.values>k3s/consent-trust-anchor.yaml</deploy.consentAuthority.values>
                <deploy.provider.values>k3s/provider.yaml,k3s/consent-provider.yaml</deploy.provider.values>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-compiler-plugin</artifactId>
                        <configuration>
                            <skip>true</skip>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <version>${version.org.apache.maven.plugins.maven-failsafe}</version>
                        <configuration>
                            <skip>true</skip>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>eidas</id>
            <properties>
                <deploy.provider.values>k3s/provider-eidas.yaml</deploy.provider.values>
                <deploy.consumer.values>k3s/consumer-eidas.yaml</deploy.consumer.values>
            </properties>
        </profile>
        <profile>
            <id>dsp</id>
            <properties>
                <deploy.provider.values>k3s/provider.yaml,k3s/dsp-provider.yaml</deploy.provider.values>
                <deploy.consumer.values>k3s/consumer.yaml,k3s/consumer-auth.yaml,k3s/consumer-tmf.yaml,k3s/dsp-consumer.yaml</deploy.consumer.values>
            </properties>
        </profile>
        <profile>
            <id>central</id>
            <properties>
                <deploy.consumer.values>k3s/consumer.yaml,k3s/consumer-auth.yaml,k3s/consumer-tmf.yaml</deploy.consumer.values>
            </properties>
        </profile>
        <profile>
            <id>monitoring</id>
            <properties>
                <deploy.prometheus.values>k3s/prometheus.yaml</deploy.prometheus.values>
                <deploy.provider.values>k3s/provider.yaml,k3s/monitoring.yaml</deploy.provider.values>
            </properties>
        </profile>
        <profile>
            <id>gaia-x</id>
            <properties>
                <deploy.provider.values>k3s/provider-gaia-x.yaml</deploy.provider.values>
                <deploy.consumer.values>k3s/consumer-gaia-x.yaml</deploy.consumer.values>
                <!-- the gx-registry and its Kubo peer, only needed by this scenario -->
                <deploy.gaiaxInfra>true</deploy.gaiaxInfra>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>1.8</version>
                        <executions>
                            <execution>
                                <id>prepare-gaia-x</id>
                                <phase>generate-test-sources</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <tasks>
                                        <exec executable="/bin/bash">
                                            <arg value="${main.basedir}/helpers/certs/generate-certs.sh" />
                                            <arg value="${main.basedir}/k3s" />
                                        </exec>
                                    </tasks>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
