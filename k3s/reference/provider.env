# The values the integration tests fill the provider's reference profile with (k3s/reference).
# Every host is a *.127.0.0.1.nip.io name: the cluster's CoreDNS resolves them to the ingress
# controller, and the tests reach them through the squid proxy.
ingress-class=traefik
cluster-issuer=selfsigned-issuer
did-domain=did-provider.127.0.0.1.nip.io
did=did:web:did-provider.127.0.0.1.nip.io
keycloak-domain=keycloak-provider.127.0.0.1.nip.io
realm=test-realm
verifier-domain=verifier-provider.127.0.0.1.nip.io
data-service-domain=data-provider.127.0.0.1.nip.io
tmf-domain=tmf-provider.127.0.0.1.nip.io
marketplace-domain=marketplace-provider.127.0.0.1.nip.io
tir-url=https://tir.127.0.0.1.nip.io
consumer-did=did:web:did-consumer.127.0.0.1.nip.io
# no separate data service in the test: the broker of the deployment plays it
data-service-upstream=data-service-scorpio:9090
