<!--
  Mock national trust list (territory DE) for the local demo.

  It declares the local test CA generated by https://github.com/FIWARE/eIDAS as a granted,
  qualified certificate authority (CA/QC), which is what makes VCVerifier's PKIX validation
  accept credentials whose x5c chain terminates in it.

  The certificate below must be the root that signed `elsi.keystore` in k3s/consumer-eidas.yaml -
  not just any CA from a run of the tool. Both are regenerated together; to re-derive it from the
  keystore that is actually deployed:

    python3 -c "import re,base64;print(base64.b64decode(re.search(r'keystore\.p12:\s*([A-Za-z0-9+/=]+)',open('k3s/consumer-eidas.yaml').read()).group(1)).hex())" >/dev/null
    # or, straight from an issued credential:
    echo "$ELSI_CREDENTIAL" | cut -d. -f1 | tr '_-' '/+' | awk '{print $0"=="}' | base64 -d \
      | jq -r '.x5c[-1]'
-->
